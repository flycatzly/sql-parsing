    <scm>
        <url>https://gitee.com/flycatzly/sql-parsing.git</url>
        <connection>scm:git:https://gitee.com/flycatzly/sql-parsing</connection>
        <developerConnection>scm:git:https://gitee.com/flycatzly/sql-parsing</developerConnection>
    </scm>

    <licenses>
