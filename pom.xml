    <groupId>io.github.flycatzly</groupId>
    <artifactId>sql-parsing</artifactId>
    <version>1.0.2</version>
    <name>sql-parsing</name>
    <description>sql-parsing</description>
    <url>https://gitee.com/flycatzly/sql-parsing</url>

